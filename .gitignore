# Data & large artifacts (never committed — see data/README.md)
data/**
!data/README.md
# the frozen split is committed (CLAUDE.md invariant #2); the label table is not
!data/split_manifest.json
results/figures/**
results/tables/**
!results/**/.gitkeep
*.pt
*.ckpt
*.npz
*.parquet

# Frozen-interface artifacts — committed (force past the rules above) so `make all` reproduces the
# report figure+table on a clean CPU checkout without the raw catalogs or a GPU (see docs/REPRODUCE.md).
# These are the outputs of the GPU/local-data preprocessing (M2 backbone + Stage-B export, M1 label
# table); everything upstream of them (data/raw, the crosswalk) stays ignored.
!data/label_table.parquet
!results/backbone_scores.parquet
!results/backbone_embeddings.parquet
!results/hct_predictions.parquet
!results/l2d_okati_predictions.parquet
!results/l2d_mozannar_predictions.parquet
# The report's embedded figure + cited table (regenerated byte-identically by `make eval`) are
# committed so docs/REPORT.md renders on a fresh checkout / on GitHub without running the pipeline.
!results/figures/pareto_frontier.png
!results/figures/pareto_frontier.png.manifest.json
!results/tables/summary.csv
!results/tables/summary.csv.manifest.json

# Vendored upstream code is pinned by SHA in DECISIONS.md, not committed wholesale
third_party/**
!third_party/README.md

